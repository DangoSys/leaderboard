{
  "name": "buckyball-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html .github/workflows/pages.yml .pre-commit-config.yaml",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html .github/workflows/pages.yml .pre-commit-config.yaml",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
